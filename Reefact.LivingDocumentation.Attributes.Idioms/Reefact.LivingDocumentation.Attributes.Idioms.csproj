<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\Packaging.props" />
  <Import Project="..\build\PublicSurface.props" />
  <Import Project="..\build\Shims.props" />

  <PropertyGroup>
    <PackageId>Reefact.LivingDocumentation.Attributes.Idioms</PackageId>

    <Description>
      Attributes that let code state which pattern of no catalogue of its own a type or a member participates in — patterns that have a source but no body of work of their own — each entry names its own. The
      attributes carry no behaviour and no dependency beyond the base marker: they are declarative data, read
      back by reflection, so a team can build its own inventory, diagram or architecture rules on a shared
      vocabulary instead of a naming convention. This package is independent of every other catalogue
      (ADR-0027), so nothing in it refers to a pattern of another work.
    </Description>

    <PackageTags>idioms;null-object;object-mother;design-patterns;living-documentation;architecture;attributes;annotations;documentation;archunit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.Core\Reefact.LivingDocumentation.Attributes.Core.csproj" />
  </ItemGroup>


</Project>
