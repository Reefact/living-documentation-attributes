<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\Packaging.props" />
  <Import Project="..\build\PublicSurface.props" />
  <Import Project="..\build\Shims.props" />

  <PropertyGroup>
    <PackageId>Reefact.LivingDocumentation.Attributes.DependencyInjection</PackageId>

    <Description>
      Attributes that let code state which pattern of dependency injection a type or a member participates
      in — the DI patterns, anti-patterns, code smells and lifestyles of Steven van Deursen and Mark
      Seemann — Dependency Injection Principles, Practices, and Patterns, 2019. The attributes carry no
      behaviour and no dependency beyond the base marker: they are declarative data, read back by
      reflection, so a team can build its own inventory, diagram or architecture rules on a shared
      vocabulary instead of a naming convention. This package is independent of every other catalogue
      (ADR-0027), so nothing in it refers to a pattern of another work.
    </Description>

    <PackageTags>dependency-injection;di;ioc;inversion-of-control;composition-root;constructor-injection;service-locator;lifestyle;anti-patterns;design-patterns;living-documentation;architecture;attributes;annotations;documentation;archunit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.Core\Reefact.LivingDocumentation.Attributes.Core.csproj" />
  </ItemGroup>


</Project>
