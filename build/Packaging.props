<Project>

  <!--
    Everything the packable projects share. There are eight of them — one per catalogued work, one holding
    the base marker, and the meta-package — and the alternative was the same forty lines copied eight times,
    which is the shape this repository removes everywhere else.

    What is NOT here is what must differ per package: PackageId, Description and PackageTags. A package that
    cannot say which work it carries is not worth splitting out.
  -->

  <PropertyGroup>
    <!-- Build -->
    <TargetFrameworks>netstandard2.0;netcoreapp3.1;net5.0;net6.0;net7.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- XML documentation. Not a nicety here: the library publishes no reader, so the reading rules and
         what every role means reach a consumer through this file and nowhere else. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Version. A development placeholder until a release tag carries it, and ONE number for every package:
         ADR-0027 splits the catalogues into independent packages and prescribes versioning them in lockstep
         for the first release, because loosening later is easy and tightening later is not. Semantic
         Versioning over TWO contracts — what a consumer compiles against and what it reads back. Policy:
         ADR-0021; the table: CONTRIBUTING.md. -->
    <Version>0.1.0-dev</Version>

    <!-- NuGet identity shared by every package -->
    <Authors>Sylvain AURAT</Authors>
    <Company>Reefact</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Links -->
    <PackageProjectUrl>https://github.com/Reefact/living-documentation-attributes</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Reefact/living-documentation-attributes.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- One README serves the repository and every package. A README per package would be eight files to
         keep in step, and a consumer who wants one catalogue still wants to know what the vocabulary is. -->
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- The licence travels as an SPDX expression, which is what nuget.org renders and what a consumer's
       licence scanner reads; packing the text as well would only duplicate it. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="readme.md" Visible="false" />
  </ItemGroup>

</Project>
