<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\build\Packaging.props" />

  <!--
    The meta-package. It holds no code: it exists so that a consumer who wants the whole vocabulary installs
    one package, and so that the identifier this repository published before ADR-0027 split the catalogues
    keeps meaning "all of it". PublicSurface.props is deliberately not imported — there is no surface here to
    baseline, and the seven packages it references each carry their own.

    The assembly it produces is empty. That is accepted rather than worked around with a hand-written nuspec,
    because a nuspec would be a second description of the package metadata that MSBuild already holds.
  -->

  <PropertyGroup>
    <PackageId>Reefact.LivingDocumentation.Attributes</PackageId>

    <Description>
      Every catalogue of the living-documentation vocabulary in one package: Design Patterns, Domain-Driven
      Design, Patterns of Enterprise Application Architecture, Analysis Patterns, Accounting Patterns, and the
      idioms that have no body of work of their own. Install this to get all of them, or install a single
      catalogue package to carry only the vocabulary you read.
    </Description>

    <PackageTags>design-patterns;living-documentation;architecture;attributes;annotations;documentation;archunit;ddd;gang-of-four;enterprise;analysis-patterns;accounting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.Core\Reefact.LivingDocumentation.Attributes.Core.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.GangOfFour\Reefact.LivingDocumentation.Attributes.GangOfFour.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.DomainDrivenDesign\Reefact.LivingDocumentation.Attributes.DomainDrivenDesign.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.EnterpriseApplicationArchitecture\Reefact.LivingDocumentation.Attributes.EnterpriseApplicationArchitecture.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.AnalysisPatterns\Reefact.LivingDocumentation.Attributes.AnalysisPatterns.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.AccountingPatterns\Reefact.LivingDocumentation.Attributes.AccountingPatterns.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.XUnitTestPatterns\Reefact.LivingDocumentation.Attributes.XUnitTestPatterns.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.EnterpriseIntegration\Reefact.LivingDocumentation.Attributes.EnterpriseIntegration.csproj" />
    <ProjectReference Include="..\Reefact.LivingDocumentation.Attributes.Idioms\Reefact.LivingDocumentation.Attributes.Idioms.csproj" />
  </ItemGroup>


</Project>
